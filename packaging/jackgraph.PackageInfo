name			jackgraph
version			0.2-2
architecture	x86_64
summary			"JACK patchbay and server control (RenkuOS)"
description		"A native Interface Kit application to start and stop the JACK server,
adjust its settings, and view and manage port connections on a graph canvas. The GUI
front-end for the JACK side of the RenkuOS audio stack."
packager		"rations <ehqcar@proton.me>"
vendor			"rations"
copyrights {
	"2026 rations"
}
licenses {
	"MIT"
}
provides {
	jackgraph = 0.2
	app:JackGraph = 0.2
}
requires {
	jack
}
urls {
	"https://github.com/rations/jack-graph-renku"
}
